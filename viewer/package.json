{
  "name": "soporte-lan-viewer",
  "private": true,
  "type": "module",
  "workspaces": [
    "bridge",
    "ui"
  ],
  "scripts": {
    "dev": "concurrently -n bridge,ui -c cyan,magenta \"npm:dev:bridge\" \"npm:dev:ui\"",
    "dev:bridge": "npm --workspace bridge run dev",
    "dev:ui": "npm --workspace ui run dev",
    "build": "npm --workspace bridge run build && npm --workspace ui run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
